{
  "name": "@ah/hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run sync:design && wrangler dev",
    "deploy": "npm run sync:design && wrangler deploy",
    "sync:design": "node ./scripts/sync-design.mjs",
    "db:migrate:local": "wrangler d1 migrations apply ah-hub --local",
    "db:migrate": "wrangler d1 migrations apply ah-hub --remote",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ah/contract": "*",
    "@ah/design": "*",
    "@ah/worker-kit": "*",
    "better-auth": "^1.2.8",
    "drizzle-orm": "^0.43.1",
    "hono": "^4.7.7",
    "katex": "^0.16.21",
    "marked": "^15.0.8",
    "marked-katex-extension": "^5.1.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250416.0",
    "typescript": "^5.8.3",
    "wrangler": "^4.14.0"
  }
}
